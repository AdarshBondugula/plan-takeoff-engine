# AI Takeoff Pro - Environment Variables
# Copy this file to '.env' and fill in your API keys

# ── Google Gemini API (primary vision model for visual takeoff) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── OpenRouter API (for document metadata extraction) ────────────────────────
# Vision-capable models on OpenRouter (supports image input):
#   google/gemini-2.5-flash     — fast, cheap, excellent OCR/vision (recommended)
#   google/gemini-3.5-flash     — newer, better quality
#   anthropic/claude-opus-4.8   — highest quality, higher cost
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Server configuration ─────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# ── App configuration (used in API headers and UI) ───────────────────────────
APP_NAME=AI Takeoff Pro
APP_BASE_URL=http://localhost:8000
